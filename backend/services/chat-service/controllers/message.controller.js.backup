// backend/services/chat-service/controllers/message.controller.js
// ============================================

const MessageModel = require('../models/message.model');
const RoomModel = require('../models/room.model');
const eventEmitter = require('../../../shared/events/event-emitter');
const logger = require('../../../shared/utils/logger');

class MessageController {
  async getMessages(req, res) {
    try {
      const { roomId } = req.params;
      const userId = req.headers['x-user-id'];
      const { limit, before, after } = req.query;

      // Verify membership
      const isMember = await RoomModel.isMember(roomId, userId);
      if (!isMember) {
        return res.status(403).json({ error: 'Access denied' });
      }

      const messages = await MessageModel.findByRoomId(roomId, {
        limit: parseInt(limit) || 50,
        before,
        after,
      });

      res.json(messages);
    } catch (error) {
      logger.error({ error: error.message }, 'Failed to get messages');
      res.status(500).json({ error: 'Failed to fetch messages' });
    }
  }

  async sendMessage(req, res) {
    try {
      const userId = req.headers['x-user-id'];
      const { roomId, content, encrypted, type, fileUrl, replyTo } = req.body;

      if (!roomId || !content) {
        return res.status(400).json({ error: 'Room ID and content are required' });
      }

      // Verify membership
      const isMember = await RoomModel.isMember(roomId, userId);
      if (!isMember) {
        return res.status(403).json({ error: 'Access denied' });
      }

      // Create message
      const message = await MessageModel.create({
        roomId,
        userId,
        content,
        encrypted,
        type,
        fileUrl,
        replyTo,
      });

      // Update room activity
      await RoomModel.updateLastActivity(roomId);

      // Get full message with user info
      const fullMessage = await MessageModel.findById(message.id);

      // Publish to Redis for real-time delivery
      await eventEmitter.publish(`room:${roomId}`, {
        type: 'new_message',
        data: fullMessage,
      });

      logger.info({ messageId: message.id, roomId, userId }, 'Message sent');

      res.status(201).json(fullMessage);
    } catch (error) {
      logger.error({ error: error.message }, 'Failed to send message');
      res.status(500).json({ error: 'Failed to send message' });
    }
  }

  async markAsRead(req, res) {
    try {
      const { roomId } = req.params;
      const userId = req.headers['x-user-id'];
      const { messageIds } = req.body;

      if (!Array.isArray(messageIds)) {
        return res.status(400).json({ error: 'Message IDs must be an array' });
      }

      // Verify membership
      const isMember = await RoomModel.isMember(roomId, userId);
      if (!isMember) {
        return res.status(403).json({ error: 'Access denied' });
      }

      await MessageModel.markAsRead(roomId, userId, messageIds);

      // Publish event
      await eventEmitter.publish(`room:${roomId}`, {
        type: 'messages_read',
        data: { userId, messageIds },
      });

      res.json({ success: true });
    } catch (error) {
      logger.error({ error: error.message }, 'Failed to mark messages as read');
      res.status(500).json({ error: 'Failed to mark as read' });
    }
  }

  async deleteMessage(req, res) {
    try {
      const { messageId } = req.params;
      const userId = req.headers['x-user-id'];

      const message = await MessageModel.findById(messageId);

      if (!message) {
        return res.status(404).json({ error: 'Message not found' });
      }

      // Only message author can delete
      if (message.user_id !== userId) {
        return res.status(403).json({ error: 'Access denied' });
      }

      await MessageModel.delete(messageId);

      // Publish event
      await eventEmitter.publish(`room:${message.room_id}`, {
        type: 'message_deleted',
        data: { messageId },
      });

      res.json({ success: true });
    } catch (error) {
      logger.error({ error: error.message }, 'Failed to delete message');
      res.status(500).json({ error: 'Failed to delete message' });
    }
  }

  async updateMessage(req, res) {
    try {
      const { messageId } = req.params;
      const userId = req.headers['x-user-id'];
      const { content } = req.body;

      if (!content) {
        return res.status(400).json({ error: 'Content is required' });
      }

      const message = await MessageModel.findById(messageId);

      if (!message) {
        return res.status(404).json({ error: 'Message not found' });
      }

      // Only message author can edit
      if (message.user_id !== userId) {
        return res.status(403).json({ error: 'Access denied' });
      }

      const updatedMessage = await MessageModel.update(messageId, content);

      // Publish event
      await eventEmitter.publish(`room:${message.room_id}`, {
        type: 'message_updated',
        data: updatedMessage,
      });

      res.json(updatedMessage);
    } catch (error) {
      logger.error({ error: error.message }, 'Failed to update message');
      res.status(500).json({ error: 'Failed to update message' });
    }
  }

  async searchMessages(req, res) {
    try {
      const { roomId } = req.params;
      const userId = req.headers['x-user-id'];
      const { query, limit } = req.query;

      if (!query) {
        return res.status(400).json({ error: 'Search query is required' });
      }

      // Verify membership
      const isMember = await RoomModel.isMember(roomId, userId);
      if (!isMember) {
        return res.status(403).json({ error: 'Access denied' });
      }

      const messages = await MessageModel.search(roomId, query, parseInt(limit) || 20);

      res.json(messages);
    } catch (error) {
      logger.error({ error: error.message }, 'Failed to search messages');
      res.status(500).json({ error: 'Failed to search messages' });
    }
  }

  async getUnreadCount(req, res) {
    try {
      const { roomId } = req.params;
      const userId = req.headers['x-user-id'];

      const count = await MessageModel.getUnreadCount(roomId, userId);

      res.json({ count });
    } catch (error) {
      logger.error({ error: error.message }, 'Failed to get unread count');
      res.status(500).json({ error: 'Failed to get unread count' });
    }
  }
}

module.exports = new MessageController();
// Get task comments
exports.getTaskComments = async (req, res) => {
  try {
    const { taskId } = req.params;
    const before = req.query.before;
    const limit = parseInt(req.query.limit) || 50;

    let query = `
      SELECT m.*, u.username, u.avatar_url
      FROM messages m
      JOIN users u ON m.user_id = u.id
      WHERE m.task_id = $1
    `;
    
    const params = [taskId];

    if (before) {
      query += ` AND m.created_at < $2`;
      params.push(before);
    }

    query += ` ORDER BY m.created_at DESC LIMIT $${params.length + 1}`;
    params.push(limit);

    const { rows } = await postgres.query(query, params);

    res.json(rows.reverse());
  } catch (error) {
    logger.error({ error: error.message }, 'Get task comments error');
    res.status(500).json({ error: 'Failed to get comments' });
  }
};

// Add task comment
exports.addTaskComment = async (req, res) => {
  try {
    const { taskId } = req.params;
    const { content } = req.body;

    if (!content || !content.trim()) {
      return res.status(400).json({ error: 'Content is required' });
    }

    const { rows } = await postgres.query(
      `INSERT INTO messages (task_id, user_id, content, type, created_at)
       VALUES ($1, $2, $3, 'text', NOW())
       RETURNING *`,
      [taskId, req.userId, content]
    );

    const comment = rows[0];

    // Get user info
    const { rows: userRows } = await postgres.query(
      'SELECT username, avatar_url FROM users WHERE id = $1',
      [req.userId]
    );

    comment.username = userRows[0].username;
    comment.avatar_url = userRows[0].avatar_url;

    // Publish event
    await redis.publish(`task:${taskId}`, JSON.stringify({
      type: 'comment_added',
      data: comment,
    }));

    logger.info({ taskId, commentId: comment.id }, 'Task comment added');

    res.status(201).json(comment);
  } catch (error) {
    logger.error({ error: error.message }, 'Add task comment error');
    res.status(500).json({ error: 'Failed to add comment' });
  }
};
